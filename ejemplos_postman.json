{
    "info": {
      "name": "Video Downloader API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Download Video (YouTube)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\"url\":\"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\"format\":\"mp4\",\"return_file\":true}"
          },
          "url": { "raw": "{{baseUrl}}/api/download", "host": ["{{baseUrl}}"], "path": ["api","download"] }
        }
      },
      {
        "name": "Get Video Info",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\"url\":\"https://www.youtube.com/watch?v=dQw4w9WgXcQ\"}"
          },
          "url": { "raw": "{{baseUrl}}/api/info", "host": ["{{baseUrl}}"], "path": ["api","info"] }
        }
      },
      {
        "name": "Cleanup Temp Files",
        "request": {
          "method": "POST",
          "url": { "raw": "{{baseUrl}}/api/cleanup", "host": ["{{baseUrl}}"], "path": ["api","cleanup"] }
        }
      },
      {
        "name": "Download Video (Instagram)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\"url\":\"https://www.instagram.com/p/EJEMPLO_POST/\",\"return_file\":true}"
          },
          "url": { "raw": "{{baseUrl}}/api/download", "host": ["{{baseUrl}}"], "path": ["api","download"] }
        }
      },
      {
        "name": "Download Video (TikTok)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\"url\":\"https://www.tiktok.com/@usuario/video/ID_VIDEO\",\"return_file\":true}"
          },
          "url": { "raw": "{{baseUrl}}/api/download", "host": ["{{baseUrl}}"], "path": ["api","download"] }
        }
      }
    ],
    "variable": [
      {
        "key": "baseUrl",
        "value": "https://tu-servicio.onrender.com"
      }
    ]
  }
  